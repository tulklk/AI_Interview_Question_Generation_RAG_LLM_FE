="400" as="sourcePoint"/><mxPoint x="417" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h6_16" value="6. show success, auto-redirect to /login after 3000ms" style="endArrow=block;endFill=1;html=1;whiteSpace=wrap;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#000000;" edge="1" parent="1"><mxGeometry width="273" height="38" relative="1" as="geometry"><mxPoint x="403" y="460" as="sourcePoint"/><mxPoint x="150" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h6_17" value="7. error (wrong or expired code - same UI either way)" style="endArrow=block;endFill=1;html=1;whiteSpace=wrap;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#000000;" edge="1" parent="1"><mxGeometry width="266" height="38" relative="1" as="geometry"><mxPoint x="663" y="500" as="sourcePoint"/><mxPoint x="417" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h6_18" value="8. clear all OTP boxes, refocus first" style="endArrow=block;endFill=1;html=1;fontSize=11;align=left;verticalAlign=middle;labelBackgroundColor=#ffffff;rounded=0;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="417" y="550" as="sourcePoint"/><mxPoint x="417" y="570" as="targetPoint"/><Array as="points"><mxPoint x="480" y="550"/><mxPoint x="480" y="570"/></Array></mxGeometry></mxCell><mxCell id="h6_19" value="9. click Resend (60s cooldown)" style="endArrow=block;endFill=1;html=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="660" as="sourcePoint"/><mxPoint x="403" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h6_20" value="10. POST /api/auth/resend-verification {email}" style="endArrow=block;endFill=1;html=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#000000;" edge="1" parent="1